# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# ใส่ตอน dev เพื่อให้ slash command ขึ้นทันทีเฉพาะใน guild นี้ (ไม่ต้องรอ global sync ~1 ชม.)
# ใส่ได้หลาย guild พร้อมกันโดยคั่นด้วยจุลภาค เช่น 908628159627399179,123456789012345678
# ถ้าปล่อยว่างไว้ จะลงทะเบียนแบบ global (ใช้ได้ทุกเซิร์ฟเวอร์ที่เชิญบอทเข้า แต่ใช้เวลาราว 1 ชม. กว่าจะ sync)
DISCORD_GUILD_ID=your-server-id

# LNbits treasury wallet (สร้าง wallet ใหม่สักใบ ตั้งชื่อว่า "Sats Vault Treasury")
# เอาคีย์จากปุ่ม API info ในหน้า wallet นั้น
LNBITS_URL=https://your-lnbits-instance.com
LNBITS_ADMIN_KEY=treasury-wallet-admin-key
LNBITS_INVOICE_KEY=treasury-wallet-invoice-read-key

# path ไฟล์ sqlite (ปล่อยค่า default ได้)
DB_PATH=./vault.db
